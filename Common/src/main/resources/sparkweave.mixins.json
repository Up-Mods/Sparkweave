{
  "required": true,
  "minVersion": "0.8",
  "package": "dev.upcraft.sparkweave.mixin",
  "plugin": "dev.upcraft.sparkweave.SparkweaveMixinConfigPlugin",
  "compatibilityLevel": "JAVA_${java_version}",
  "mixins": [
    "BlockEntityMixin",
    "LecternBlockEntityMixin",
    "LecternBlockMixin"
  ],
  "client": [
    "client.MinecraftMixin",
    "client.RenderLayerMixin",
    "client.customarmor.HumanoidArmorLayerMixin",
    "client.customarmor.HumanoidMobRendererMixin",
    "client.debug.AbstractContainerScreenMixin",
    "client.lectern.BlockEntityRenderersMixin",
    "client.lectern.LecternRendererMixin",
    "client.renderstateext.BlockEntityRenderStateMixin"
  ],
  "injectors": {
    "defaultRequire": 1
	}
}
