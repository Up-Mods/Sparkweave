{
  "schemaVersion": 1,
  "id": "${mod_id}_testmod",
  "version": "${version}",
  "name": "${mod_display_name} TestMod",
  "description": "Testmod for ${mod_display_name}",
  "authors": [
    "Up"
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "license": "${license_url}",
  "icon": "icon.png",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "${mod_id}": "=${version}",
    "fabric-api": "*",
    "minecraft": "=${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "parent": "${mod_id}"
    }
  }
}
